  breathingText: "\u0627\u0644\u062A\u0646\u0641\u0633 \u0627\u0644\u0635\u062D\u064A\u062D
    \u0647\u0648 \u0623\u0647\u0645 \u062E\u0637\u0648\u0629 \u0641\u064A \u062A\u062E\u0641\u064A\u0641
