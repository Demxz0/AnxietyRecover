  m_Script: {fileID: 11500000, guid: ca007d3f3b776184cbdce0b34a93c874, type: 3}
  m_Name: Bathroom_WaitingText
  m_EditorClassIdentifier: Assembly-CSharp::NarrativeEntry
  text: "\u0644\u0627 \u062A\u0637\u0644\u0628 \u0627\u0644\u0637\u0645\u0623\u0646\u064A\u0646\u0629
    \u0627\u0644\u0645\u0633\u062A\u0645\u0631\u0629\n\u062E\u0635\u0648\u0635\u064B\u0627
    \u0627\u0644\u0637\u0645\u0623\u0646\u064A\u0646\u0629 \u0627\u0644\u0632\u0627\u0626\u0641\u0629
    \u0645\u062B\u0644: \"\u0643\u0644 \u0634\u064A\u0621 \u0633\u064A\u0643\u0648\u0646
    \u0628\u062E\u064A\u0631\" \u0623\u0648 \"\u0627\u0644\u0623\u0645\u0648\u0631
    \u0633\u062A\u0646\u062C\u062D\".\n\u0642\u062F \u062A\u0628\u062F\u0648 \u0645\u0631\u064A\u062D\u0629
    \u0645\u0624\u0642\u062A\u064B\u0627\u060C \u0644\u0643\u0646\u0647\u0627 \u062A\u0632\u064A\u062F
    \u0627\u0644\u0642\u0644\u0642.\n\u0639\u0642\u0644\u0643 \u0644\u0627 \u064A\u0635\u062F\u0642\u0647\u0627
    \u0644\u0623\u0646\u0647 \u064A\u0639\u0644\u0645 \u0623\u0646\u0647\u0627 \u063A\u064A\u0631
    \u0645\u0624\u0643\u062F\u0629.\n\u0628\u062F\u0644\u064B\u0627 \u0645\u0646
    \u062A\u0647\u062F\u0626\u0629 \u0627\u0644\u0642\u0644\u0642\u060C \u062A\u0635\u0628\u062D
    \u0627\u0644\u0637\u0645\u0623\u0646\u064A\u0646\u0629 \u0627\u0644\u0632\u0627\u0626\u0641\u0629
    \u0643\u0627\u0644\u0625\u062F\u0645\u0627\u0646\u060C \u0648\u062A\u062F\u0641\u0639
    \u0639\u0642\u0644\u0643 \u0644\u0637\u0644\u0628 \u0627\u0644\u0645\u0632\u064A\u062F."
