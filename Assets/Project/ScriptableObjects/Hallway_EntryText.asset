  m_Name: Hallway_EntryText
  m_EditorClassIdentifier: Assembly-CSharp::NarrativeEntry
  text: "\u062B\u0628\u062A \u0639\u0644\u0645\u064A\u064B\u0627 \u0623\u0646 \u0627\u0644\u0642\u0644\u0642
    \u063A\u0627\u0644\u0628\u064B\u0627 \u0644\u0627 \u064A\u0623\u062A\u064A \u0644\u0623\u0646
    \u0647\u0646\u0627\u0643 \u062E\u0644\u0644\u064B\u0627 \u0641\u064A\u0643\u060C
    \u0628\u0644 \u064A\u0623\u062A\u064A \u0644\u0623\u0646\u0643 \u0644\u0627 \u062A\u062A\u062D\u0645\u0651\u0644
    \u062D\u0627\u0644\u0629 \u0639\u062F\u0645 \u0627\u0644\u0648\u0636\u0648\u062D
    \u0627\u0644\u062A\u064A \u0642\u062F \u062A\u0643\u0648\u0646 \u0645\u0646 \u062D\u0648\u0644\u0643.\n\u0644\u0630\u0644\u0643\u060C
    \u0645\u0627 \u062A\u0641\u0639\u0644\u0647 \u0647\u0648 \u0623\u0646\u0643 \u062A\u062D\u0627\u0648\u0644
    \u0627\u0633\u062A\u0639\u0627\u062F\u0629 \u0627\u0644\u0633\u064A\u0637\u0631\u0629\u060C
    \u0648\u0644\u0643\u0646\u0643 \u062A\u0641\u0639\u0644 \u0630\u0644\u0643 \u0628\u0627\u0644\u0637\u0631\u064A\u0642\u0629
    \u0627\u0644\u062A\u064A \u062A\u0639\u0631\u0641\u0647\u0627:\n\u0627\u0644\u0625\u0641\u0631\u0627\u0637
    \u0641\u064A \u0627\u0644\u062A\u0641\u0643\u064A\u0631\u060C \u0648\u0627\u0644\u0625\u0641\u0631\u0627\u0637
    \u0641\u064A \u0627\u0644\u062A\u062E\u0637\u064A\u0637\u060C \u0648\u0627\u0644\u0625\u0641\u0631\u0627\u0637
    \u0641\u064A \u0627\u0644\u062A\u062D\u0636\u064A\u0631.\n\u0644\u0643\u0646
    \u0647\u0630\u0647 \u0641\u064A \u0627\u0644\u062D\u0642\u064A\u0642\u0629 \u0645\u062D\u0627\u0648\u0644\u0627\u062A
    \u062A\u0645\u0646\u062D\u0643 \u0625\u062D\u0633\u0627\u0633\u064B\u0627 \u0632\u0627\u0626\u0641\u064B\u0627
    \u0628\u0627\u0644\u0623\u0645\u0627\u0646."
