  text: "\u062A\u0642\u0628\u0651\u0644 \u0623\u0646 \u0627\u0644\u0623\u0644\u0645
    \u0627\u0644\u0639\u0627\u0637\u0641\u064A \u0623\u0645\u0631 \u0644\u0627 \u0645\u0641\u0631
    \u0645\u0646\u0647\r\n\u0627\u0644\u0642\u0644\u0642 \u063A\u0627\u0644\u0628\u064B\u0627
    \u064A\u062D\u0627\u0648\u0644 \u062D\u0645\u0627\u064A\u062A\u0643 \u0645\u0646
    \u0645\u0634\u0627\u0639\u0631 \u0645\u062B\u0644 \u0627\u0644\u062D\u0632\u0646\u060C
    \u0623\u0648 \u0627\u0644\u0625\u062D\u0631\u0627\u062C\u060C \u0623\u0648 \u062E\u064A\u0628\u0629
    \u0627\u0644\u0623\u0645\u0644.\r\n\u0648\u0643\u062B\u064A\u0631 \u0645\u0646
    \u0627\u0644\u0623\u0634\u062E\u0627\u0635 \u0627\u0644\u0630\u064A\u0646 \u064A\u0639\u0627\u0646\u0648\u0646
    \u0645\u0646 \u0627\u0644\u0642\u0644\u0642 \u062A\u0639\u0644\u0651\u0645\u0648\u0627
    \u0645\u0646\u0630 \u0637\u0641\u0648\u0644\u062A\u0647\u0645 \u0623\u0646 \u0627\u0644\u062E\u0637\u0623
    \u0645\u062E\u064A\u0641\u060C \u0623\u0648 \u0623\u0646 \u0627\u0644\u0631\u0641\u0636
    \u0645\u0624\u0644\u0645 \u062C\u062F\u064B\u0627\u060C \u0623\u0648 \u0623\u0646
    \u0639\u0644\u064A\u0647\u0645 \u0627\u0644\u0628\u0642\u0627\u0621 \u0641\u064A
    \u062D\u0627\u0644\u0629 \u0627\u0646\u062A\u0628\u0627\u0647 \u062F\u0627\u0626\u0645
    \u062D\u062A\u0649 \u064A\u0634\u0639\u0631\u0648\u0627 \u0628\u0627\u0644\u0623\u0645\u0627\u0646.\r\n\u0644\u0647\u0630\u0627
    \u064A\u0635\u0628\u062D \u0627\u0644\u0639\u0642\u0644 \u0645\u0639 \u0627\u0644\u0648\u0642\u062A
    \u0645\u0639\u062A\u0627\u062F\u064B\u0627 \u0639\u0644\u0649 \u062A\u0648\u0642\u0651\u0639
    \u0627\u0644\u0623\u0633\u0648\u0623 \u0648\u0645\u062D\u0627\u0648\u0644\u0629
    \u0627\u0644\u0633\u064A\u0637\u0631\u0629 \u0639\u0644\u0649 \u0643\u0644 \u0634\u064A\u0621
    \u0642\u0628\u0644 \u062D\u062F\u0648\u062B\u0647.\r\n\r\n\u0644\u0643\u0646
    \u0645\u062D\u0627\u0648\u0644\u0629 \u062A\u062C\u0646\u0651\u0628 \u0627\u0644\u0623\u0644\u0645
    \u0637\u0648\u0627\u0644 \u0627\u0644\u0648\u0642\u062A \u062A\u064F\u0628\u0642\u064A
    \u0627\u0644\u0642\u0644\u0642 \u0645\u0633\u064A\u0637\u0631\u064B\u0627.\r\n\u0639\u0646\u062F\u0645\u0627
    \u064A\u062F\u0631\u0643 \u0639\u0642\u0644\u0643 \u0623\u0646\u0643 \u0642\u0627\u062F\u0631
    \u0639\u0644\u0649 \u062A\u062D\u0645\u0651\u0644 \u0627\u0644\u0645\u0634\u0627\u0639\u0631
    \u0627\u0644\u0635\u0639\u0628\u0629\u060C \u0648\u0623\u0646\u0643 \u0644\u0633\u062A
    \u0630\u0644\u0643 \u0627\u0644\u0637\u0641\u0644 \u0627\u0644\u0639\u0627\u062C\u0632
    \u0627\u0644\u0630\u064A \u0643\u0627\u0646 \u064A\u062E\u0627\u0641 \u0645\u0646
    \u0643\u0644 \u0634\u064A\u0621\u060C \u064A\u0628\u062F\u0623 \u0627\u0644\u0642\u0644\u0642
    \u0628\u0627\u0644\u062A\u0631\u0627\u062C\u0639 \u062A\u062F\u0631\u064A\u062C\u064A\u064B\u0627."
